# TraceIQ Local Environment Configuration
# Copy this file to .env for local development.
# Never commit .env or real credentials to source control.

# Server & Runtime Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL 16 Database
# Default host port is 5432. If 5432 is already in use by a local host service, set POSTGRES_PORT=5433
POSTGRES_PORT=5432
DATABASE_URL=postgresql://traceiq:traceiq_local_only@localhost:5432/traceiq

# Local Artifact Storage (stores raw reports and logs outside relational DB)
ARTIFACT_STORAGE_PATH=./.local-artifacts

# Webhook Secrets (placeholder for future ingestion milestone)
GITHUB_WEBHOOK_SECRET=replace_with_local_test_secret

# Note: Queue/Cache (e.g. Redis vs PostgreSQL queue) is an open architectural decision (see DECISIONS.md)
# and is not configured in Milestone 0.
